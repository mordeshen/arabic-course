  "reading_exercises": [
    {
      "id": "ex_01",
      "title": "חיפוש עבודה",
      "level": "beginner",
      "topic": "עבודה",
      "source_style": "صبايا الخير",
      "arabic_text": "مرحبا صبايا، أنا بنت عمري ٢٠ سنه، خلصت توجيهي وبدور على شغل. في حدا بعرف محل أو شركه بتشغّل بنات؟ بدي اشي قريب من البيت وسعر كويس. اللي بتعرف تراسلني. الله يجزيكم الخير.",
      "key_vocabulary": [
        "بدور على",
        "شغل",
        "في حدا",
        "بدي",
        "اللي"
      ],
      "questions": [
