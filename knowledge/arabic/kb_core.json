    "vowel_changes_in_dialect": {
      "description": "שינויי תנועות אופייניים לדיאלקט הפלסטיני",
      "rules": [
        {
          "formal": "قَ (qāf)",
          "palestinian": "אַ (hamza/alef) או כּ (kāf) לפי אזור",
          "example": "قال → אָאל (אמר)"
        },
        {
          "formal": "ث (thā')",
          "palestinian": "ת (tā') או ס (sīn)",
          "example": "ثلاثة → תְלָאתֶה (שלוש)"
        },
        {
          "formal": "ذ (dhāl)",
          "palestinian": "ד (dāl) או ז (zāy)",
          "example": "هذا → הָאדָא (זה)"
        }
      ]
    }
