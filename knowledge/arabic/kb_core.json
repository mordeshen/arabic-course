  "grammar_essentials": {
    "negation": {
      "description": "שלילה בערבית פלסטינית",
      "rules": [
        {
          "type": "שלילת פועל",
          "pattern": "مَا + פועל + ش",
          "example": "ما بعرفش = אני לא יודע",
          "note": "ה-ش אופציונלי בפלסטיני, חובה בלבנוני"
        },
        {
          "type": "שלילת שם/תואר",
          "pattern": "مش + שם/תואר",
          "example": "مش منيح = לא טוב"
        },
        {
          "type": "אין/אף",
          "pattern": "ما في / ولا",
          "example": "ما في حدا = אין אף אחד"
        },
        {
          "type": "עדיין לא",
          "pattern": "لسّا + מילת שלילה",
          "example": "لسّا ما وصل = עדיין לא הגיע"
        }
      ]
    },
