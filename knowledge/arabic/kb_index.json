{
  "meta": {
    "file": "kb_index.json",
    "layer": "orchestrator",
    "version": "2.1",
    "updated": "2026-03-25",
    "description": "Master index and routing layer for Palestinian Arabic KB",
    "kb_files": [
      "kb_core.json",
      "kb_dictionary.json",
      "kb_phrases.json",
      "kb_conjugations.json",
      "kb_culture.json"
    ]
  },
  "routing": {
    "description": "Which file to query based on query type",
    "rules": [
      {
        "query_type": "word_lookup",
        "description": "User asks meaning of a specific word",
        "signals": [
          "what does X mean",
          "מה זה",
          "מה פירוש",
          "translate"
        ],
        "primary": "kb_dictionary.json",
        "fallback": "kb_phrases.json"
      },
      {
        "query_type": "pronunciation",
        "description": "How to pronounce, sun/moon letters, vowels",
        "signals": [
          "how to say",
          "pronounce",
          "sun letter",
          "moon letter",
          "stress"
        ],
        "primary": "kb_core.json",
        "section": "phonology"
      },
      {
        "query_type": "grammar",
        "description": "Grammar rules — negation, questions, prepositions",
        "signals": [
          "how to negate",
          "how to ask",
          "plural",
          "grammar",
          "rule"
        ],
        "primary": "kb_core.json",
        "section": "grammar_essentials"
      },
      {
        "query_type": "verb_conjugation",
        "description": "How to conjugate a verb",
        "signals": [
          "conjugate",
          "past tense",
          "present tense",
          "imperative",
          "how do I say I did"
        ],
        "primary": "kb_conjugations.json",
        "fallback": "kb_core.json"
      },
      {
        "query_type": "phrase_generation",
        "description": "How to say a sentence or expression",
        "signals": [
          "how do I say",
          "expression for",
          "phrase",
          "sentence"
        ],
        "primary": "kb_phrases.json",
        "fallback": "kb_dictionary.json"
      },
      {
        "query_type": "cultural",
        "description": "Cultural norms, register, dialect differences",
        "signals": [
          "formal vs informal",
          "polite way",
          "dialect",
          "MSA vs colloquial"
        ],
        "primary": "kb_culture.json",
        "fallback": "kb_core.json"
      },
      {
        "query_type": "topic_vocabulary",
        "description": "Vocabulary around a topic",
        "signals": [
          "words for",
          "vocabulary about",
          "how to talk about"
        ],
        "primary": "kb_dictionary.json",
        "filter_by": "category"
      }
    ]
  },
  "ingestion_pipeline": {
    "description": "How to process new documents and add them to the KB",
    "supported_source_types": [
      "dictionary_pages",
      "conversation_transcripts",
      "grammar_chapters",
      "phrase_lists",
      "cultural_texts"
    ],
    "steps": [
      {
        "step": 1,
        "name": "identify_source_type",
        "description": "Determine what kind of document this is",
        "decision_tree": {
          "has_word_definitions": "dictionary_pages → kb_dictionary.json",
          "is_dialogue_or_conversation": "conversation_transcripts → kb_phrases.json",
          "explains_grammar_rules": "grammar_chapters → kb_core.json",
          "is_list_of_sentences": "phrase_lists → kb_phrases.json",
          "describes_customs_or_society": "cultural_texts → kb_culture.json",
          "has_verb_tables": "grammar_chapters → kb_conjugations.json"
        }
      },
      {
        "step": 2,
        "name": "extract_entries",
        "description": "Parse document into structured entries",
        "for_dictionary_pages": {
          "required_fields": [
            "word",
            "translation",
            "pos"
          ],
          "optional_fields": [
            "root",
            "forms",
            "examples",
            "collocations",
            "notes"
          ],
          "format": {
            "word": "Arabic word in Hebrew script (Palestinian pronunciation)",
            "translation": "Hebrew or English meaning",
            "pos": "verb | noun | adjective | adverb | preposition | particle | pronoun | interjection",
            "root": "trilateral root e.g. כ-ת-ב",
            "forms": {
              "plural": "...",
              "fem": "...",
              "active_participle": "..."
            },
            "examples": [
              {
                "ar": "Arabic example",
                "he": "Hebrew translation"
              }
            ],
            "collocations": [
              "phrase1",
              "phrase2"
            ],
            "notes": "dialect notes, usage warnings, cultural context",
            "register": "colloquial | formal | universal | vulgar",
            "frequency": "high | medium | low"
          }
        },
        "for_phrases": {
          "required_fields": [
            "phrase_ar",
            "phrase_he",
            "category"
          ],
          "optional_fields": [
            "register",
            "response",
            "notes",
            "literal_translation"
          ],
          "categories": [
            "greetings",
            "farewells",
            "gratitude",
            "apology",
            "questions",
            "responses",
            "affirmations",
            "negations",
            "suggestions",
            "requests",
            "emotions",
            "discourse_markers",
            "assertiveness",
            "reassurance",
            "interpersonal"
          ]
        },
        "for_conjugations": {
          "required_fields": [
            "root",
            "base",
            "translation"
          ],
          "required_tables": [
            "past",
            "present"
          ],
          "optional_tables": [
            "imperative",
            "future",
            "subjunctive"
          ],
          "person_codes": [
            "1sg",
            "2sg_m",
            "2sg_f",
            "3sg_m",
            "3sg_f",
            "1pl",
            "2pl",
            "3pl"
          ]
        },
        "for_grammar": {
          "structure": {
            "rule_name": "short identifier",
            "explanation": "plain language explanation",
            "pattern": "template with slots",
            "examples": [
              {
                "ar": "...",
                "he": "..."
              }
            ],
            "exceptions": []
          }
        }
      },
      {
        "step": 3,
        "name": "deduplicate",
        "description": "Check if word/phrase already exists before adding",
        "method": "compare 'word' field against existing entries in target file",
        "on_duplicate": "merge examples and collocations, keep most complete entry"
      },
      {
        "step": 4,
        "name": "tag_and_categorize",
        "description": "Add category, source, register, frequency tags",
        "auto_category_by_first_letter": true,
        "frequency_heuristic": "if has 3+ examples → high; 1-2 examples → medium; 0 → low"
      },
      {
        "step": 5,
        "name": "write_to_target_file",
        "description": "Append to correct kb_*.json file",
        "always_update": [
          "kb_index.json → word_index section"
        ]
      },
      {
        "step": 6,
        "name": "update_index",
        "description": "Add new words to word_index in kb_index.json",
        "fields_to_index": [
          "word",
          "translation_first_word",
          "category"
        ]
      }
    ]
  },
